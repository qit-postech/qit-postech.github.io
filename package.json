{
  "name": "postech-qit-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check:content": "node scripts/validate-content.mjs",
    "build": "npm run check:content && astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "node scripts/verify-build.mjs",
    "preview:offline": "npm run build && node scripts/offline-preview.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  }
}
