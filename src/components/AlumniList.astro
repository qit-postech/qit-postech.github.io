---
import {t,type Lang} from '../lib/site';
const {items=[],lang='en'}=Astro.props;
const l=lang as Lang;
---
<section class="alumni-section" id="alumni" aria-labelledby="alumni-heading">
  <div class="section-heading">
    <h2 id="alumni-heading">{t(l,'Alumni','이전 구성원')}</h2>
    <span class="eyebrow">{t(l,'OUR KIST YEARS','KIST 시절의 인연')}</span>
  </div>
  <p class="alumni-intro">{t(l,'Former members of the group. Roles and dates below refer to their time with the KIST-era group; current affiliations are linked to their sources.','KIST 시절 함께 연구한 이전 구성원입니다. 당시 역할·참여 기간과 현재 소속을 구분해 소개합니다.')}</p>
  <ul class="alumni-list">
    {items.map((p:any)=><li class="alumni-person" id={p.id}>
      <div>
        <h3>{p.name[l]}</h3>
        {l==='ko'&&p.name.ko!==p.name.en&&<span class="alumni-english-name" lang="en">{p.name.en}</span>}
        <p class="alumni-role">{p.role[l]}</p>
        {p.period&&<span class="alumni-period">{p.period[l]}</span>}
        {p.historicalNote&&<p class="alumni-history">{p.historicalNote[l]}</p>}
      </div>
      <div class="alumni-affiliation">
        <span class="alumni-status">{p.affiliation.status==='official'?t(l,'CURRENT AFFILIATION','현재 소속'):p.affiliation.status==='legacy'?t(l,'FROM THE KIST ARCHIVE','KIST 사이트 당시 기록'):t(l,'CURRENT AFFILIATION','현재 소속')}</span>
        {p.affiliation.status!=='unverified'?<>
          <h4>{p.affiliation.institution[l]}</h4>
          <p>{p.affiliation.role[l]}</p>
          {p.affiliation.unit&&<p>{p.affiliation.unit[l]}</p>}
          {p.affiliation.status==='legacy'&&<p class="alumni-unverified">{t(l,'Current status needs confirmation.','현재 재직 여부는 확인이 필요합니다.')}</p>}
          <a class="alumni-source" href={p.affiliation.sourceUrl}>{p.affiliation.status==='official'?t(l,'Official source','공식 출처'):t(l,'Historical source','당시 기록 출처')} <span aria-hidden="true">↗</span></a>
          {p.affiliation.roleSourceUrl&&<a class="alumni-source" href={p.affiliation.roleSourceUrl}>{t(l,'Role reference','직급 확인 출처')} <span aria-hidden="true">↗</span></a>}
        </>:<p class="alumni-unverified">{t(l,'To be confirmed','확인 필요')}</p>}
      </div>
    </li>)}
  </ul>
  <div class="alumni-footnote">
    <p>{t(l,'Affiliations checked on 13 October 2026. “Alumni” denotes former group membership, including postdoctoral and visiting appointments.','소속 확인일: 2026년 10월 13일. 이전 구성원에는 박사후연구원과 방문·공동 소속 연구자도 포함됩니다.')}</p>
    <a class="text-link" href="https://sites.google.com/view/qitkist/group-members">{t(l,'Historical KIST roster','KIST 시절 명단')} <span aria-hidden="true">↗</span></a>
  </div>
</section>
