---
import QuantumArt from './QuantumArt.astro';
import PublicationList from './PublicationList.astro';
import AlumniList from './AlumniList.astro';
import research from '../data/research.json';
import peopleData from '../data/people.json';
import papersData from '../data/publications.json';
import newsData from '../data/news.json';
import {t,info,url,asset,review,type Lang} from '../lib/site';
const {lang='en',section='home'}=Astro.props;
const l=lang as Lang;
const people=peopleData.filter(p=>review || p.approvedForPublic);
const papers=[...papersData].sort((a:any,b:any)=>String(b.publishedDate||b.year).localeCompare(String(a.publishedDate||a.year)));
const legacyCount=papers.filter((p:any)=>p.sourceStatus==='legacy').length;
const news=newsData.filter((n:any)=>n.approvedForPublic).sort((a:any,b:any)=>b.date.localeCompare(a.date));
const years=[...new Set(papers.map((p:any)=>p.year))];
const heads:any={research:[t(l,'The science of possibility.','가능성을 탐구하는 이론.'),t(l,'Research at the interface of quantum principles and information.','양자 원리와 정보가 만나는 지점을 연구합니다.')],people:[t(l,'Ideas grow through people.','사람과 함께 자라는 아이디어.'),t(l,'Meet the people behind our quantum information research.','양자정보를 함께 탐구하는 연구자들입니다.')],publications:[t(l,'A record of discovery.','탐구의 기록.'),t(l,'Publications and preprints by Seung-Woo Lee and collaborators.','이승우 교수와 공동연구자들의 논문 및 프리프린트입니다.')],news:[t(l,'From the group.','연구실의 소식.'),t(l,'Research, conversations, and moments to share.','연구와 교류, 함께 나누고 싶은 순간들입니다.')],join:[t(l,'Bring your questions.','새로운 질문을 기다립니다.'),t(l,'Start a conversation about quantum information research.','양자정보 연구에 관한 대화를 시작해 보세요.')],contact:[t(l,'Let’s connect.','연결의 시작.'),t(l,'Quantum Information Theory Group · POSTECH','Quantum Information Theory Group · 포항공과대학교')]};
---
{section==='home' ? <>
<section class="hero container"><div class="hero-copy"><div class="eyebrow"><span class="small-line"></span>QUANTUM INFORMATION THEORY</div><h1>{l==='en'?<>Exploring<br/><em>quantum</em><br/>possibilities.</>:<>양자정보로<br/>탐구하는<br/><em>새로운 가능성.</em></>}</h1><p>{t(l,'We explore the principles of quantum information — and what they make possible for computation, communication, and sensing.','양자정보의 원리를 이해하고, 계산·통신·센싱에서 그 원리가 열어 주는 가능성을 탐구합니다.')}</p><a class="button" href={url(l,'research')}>{t(l,'Discover our research','연구 살펴보기')} <span aria-hidden="true">↗</span></a></div><div class="hero-figure"><QuantumArt/><div class="figure-caption"><span>01 — THE QUANTUM STATE</span><span>AN ILLUSTRATION OF POSSIBILITY</span></div></div></section>
<div class="affiliation-strip"><div class="container"><span>{t(l,'Quantum Information Theory Group','양자정보이론 연구실')}</span><span>{t(l,'Department of Physics','물리학과')}<i> / </i>POSTECH<i> / </i>POHANG, KOREA</span></div></div>
<section class="container section-space intro-grid"><div class="eyebrow">{t(l,'OUR RESEARCH','연구 소개')}</div><div><h2>{t(l,'Fundamental questions.','근본적인 질문에서')}<br/><em>{t(l,'Quantum perspectives.','양자적 관점으로.')}</em></h2><p class="lead">{t(l,'How can quantum systems process, transmit, and reveal information? Our research connects the foundations of quantum theory with the tools of quantum information.','양자 시스템은 어떻게 정보를 처리하고, 전달하며, 드러낼까요? 양자이론의 기초와 양자정보의 방법론을 연결해 이 질문을 탐구합니다.')}</p></div></section>
<section class="container research-grid">{research.map(r=><a class="research-card" href={`${url(l,'research')}#${r.id}`}><span class="card-index">{r.number}<span aria-hidden="true">↗</span></span><img class="research-card-figure" src={asset(r.figure.src)} alt={r.figure.alt[l]} width="800" height="480" loading="lazy" decoding="async"/><h3>{r.title[l]}</h3><p>{r.subtitle[l]}</p></a>)}</section>
<section class="container section-space"><div class="section-heading"><div><div class="eyebrow">{t(l,'LATEST PUBLICATIONS','최근 논문')}</div><h2>{t(l,'Recent publications','최근 논문')}</h2></div><a class="text-link" href={url(l,'publications')}>{t(l,'All publications','전체 논문 보기')} ↗</a></div><p class="archive-context">{t(l,'Research articles, preprints, and reviews, linked to their original sources.','연구논문·프리프린트·해설 글을 원문 출처와 함께 소개합니다.')}</p><PublicationList items={papers.slice(0,3)} lang={l} compact/></section>
<section class="join-banner"><div class="container"><div class="eyebrow">{t(l,'THINK WITH US','함께하는 연구')}</div><h2>{t(l,'Curiosity is a good','호기심은 좋은')}<br/><em>{t(l,'starting point.','출발점입니다.')}</em></h2><a class="button button-light" href={url(l,'join')}>{t(l,'Connect with the group','연구실과 연결하기')} ↗</a></div><div class="join-orbit" aria-hidden="true"></div></section>
</> : <>
<section class="container page-heading"><div class="eyebrow">{({research:'RESEARCH',people:'PEOPLE',publications:'PUBLICATIONS',news:'NEWS',join:'JOIN US',contact:'CONTACT'} as any)[section]}</div><h1>{heads[section][0]}</h1><p>{heads[section][1]}</p></section>
{section==='research'&&<div class="container research-detail">{research.map(r=><article id={r.id} class="research-row"><span class="large-index">{r.number}</span><div><h2>{r.title[l]}</h2><h3>{r.subtitle[l]}</h3><p class="lead">{r.description[l]}</p><ul class="tags">{r.tags[l].map(tag=><li>{tag}</li>)}</ul><div class="source-line"><a href={r.sourceUrl}>{t(l,'Current research interests: POSTECH','현재 연구 관심 분야: POSTECH')} ↗</a><a href={r.legacyUrl}>{t(l,'Historical context: KIST archive','이전 연구 맥락: KIST 기록')} ↗</a></div></div><figure class="research-figure"><img src={asset(r.figure.src)} alt={r.figure.alt[l]} width="800" height="480" loading="lazy" decoding="async"/><figcaption>{r.figure.caption[l]}</figcaption></figure></article>)}<p class="fine-print">{t(l,'Research descriptions have been newly written from the cited sources. Project scope and current priorities await faculty review.','출처를 토대로 새로 작성한 연구 요약입니다. 개별 프로젝트의 현재 범위와 우선순위는 교수님 확인이 필요합니다.')}</p></div>}
{section==='people'&&<div class="container content-bottom"><div class="section-heading"><h2>{t(l,'Current group','현재 구성원')}</h2><span class="eyebrow">POSTECH</span></div>{people.filter(p=>p.group==='current' && p.kind==='faculty').map(p=><article class="person"><div class="person-monogram" aria-hidden="true">SW<span>LEE</span></div><div><span class="eyebrow">{p.role[l]}</span><h2>{p.name[l]}</h2><p class="lead">{p.description[l]}</p><div class="source-line"><a href={`mailto:${p.email}`}>{p.email} ↗</a><a href={p.sourceUrl}>{t(l,'Official faculty profile','공식 교수 소개')} ↗</a></div></div></article>)}{['POSTECH','KIST'].map(institution=><section class="student-section"><div class="section-heading"><h2>{institution} {t(l,'students','학생')}</h2><span class="eyebrow">{institution==='POSTECH'?t(l,'FROM LAB PRESENTATION','연구실 발표자료 기준'):t(l,'KIST AFFILIATION','KIST 소속')}</span></div>{people.filter(p=>p.group==='current'&&p.kind==='student'&&p.institution===institution).length?<ul class="student-list">{people.filter(p=>p.group==='current'&&p.kind==='student'&&p.institution===institution).map(p=><li><div><h3>{p.name[l]}</h3><p>{p.role[l]} · {p.institution}</p></div>{review&&<span class="person-status">{p.verification==='user-presentation'?t(l,'PPT v49 · slide 2','PPT v49 · 2쪽'):t(l,'User confirmed · 13 Oct 2026','사용자 확인 · 2026.10.13')}<small>{t(l,'Faculty review pending','교수님 검토 대기')}</small></span>}</li>)}</ul>:<p>{t(l,'The roster is being prepared for publication.','공개할 구성원 명단을 준비 중입니다.')}</p>}</section>)}{review&&<div class="editorial-note"><h3>{t(l,'Roster source and scope','명단의 출처와 범위')}</h3><p>{t(l,'POSTECH doctoral students are transcribed from the user-referenced laboratory presentation. Korean name spellings were confirmed by the user. Current KIST student status was confirmed by the user; their degree stage remains unspecified. These are review entries, not an independently verified institutional directory.','POSTECH 박사과정 명단은 사용자가 지정한 연구실 PPT에서 확인했습니다. 한글 이름 최광준·서우원·조준희는 사용자 확인을 반영했습니다. KIST 학생의 현재 상태는 사용자 확인이며 세부 학위과정은 미확인입니다. 기관 공식 명단과는 구별되는 검토용 자료입니다.')}</p></div>}<AlumniList items={people.filter(p=>p.group==='alumni')} lang={l}/></div>}
{section==='publications'&&<div class="container content-bottom"><div class="archive-notice"><strong>{t(l,'A bibliography with a traceable history','출처를 확인할 수 있는 논문 목록')}</strong><p>{t(l,`This bibliography combines ${legacyCount} entries from the KIST-era archive with ${papers.length-legacyCount} newly checked records. Journal versions and their preprints share one entry when matched. Affiliations belong to the cited work; inclusion does not imply that every paper was produced at POSTECH. Last checked: 13 October 2026.`, `KIST 시절 기록 ${legacyCount}건과 새로 확인한 ${papers.length-legacyCount}건을 함께 정리했습니다. 같은 연구의 출판본과 프리프린트는 확인 가능한 경우 한 항목으로 묶었습니다. 소속은 논문 당시를 기준으로 하며, 모든 논문을 POSTECH 성과로 간주하지 않습니다. 최종 확인: 2026.10.13.`)}</p><a href="https://sites.google.com/view/qitkist/publications">{t(l,'Original bibliography','원본 논문 목록')} ↗</a></div><form class="filters" id="publication-filters" role="search"><div><label for="paper-search">{t(l,'Search publications','논문 검색')}</label><input type="search" id="paper-search" placeholder={t(l,'Title, author, keyword…','제목, 저자, 키워드…')}/></div><div><label for="paper-year">{t(l,'Year','연도')}</label><select id="paper-year"><option value="all">{t(l,'All years','전체 연도')}</option>{years.map(y=><option value={y}>{y}</option>)}</select></div><div><label for="paper-type">{t(l,'Type','유형')}</label><select id="paper-type"><option value="all">{t(l,'All types','전체 유형')}</option><option value="journal">{t(l,'Journal articles','정식 출판')}</option><option value="preprint">{t(l,'Preprints','프리프린트')}</option><option value="feature">{t(l,'Reviews / features','해설·리뷰')}</option></select></div><button class="reset-button" type="reset">{t(l,'Reset','초기화')}</button></form><p id="paper-count" class="result-count" aria-live="polite" data-en="publications" data-ko="건의 논문">{papers.length} {t(l,'publications','건의 논문')}</p><h2 class="visually-hidden">{t(l,'Publication results','논문 검색 결과')}</h2><PublicationList items={papers} lang={l}/><p id="no-results" hidden>{t(l,'No publications match your search. Try another term or year.','일치하는 논문이 없습니다. 검색어나 연도를 바꿔보세요.')}</p><p class="fine-print">{t(l,'New records were checked against publisher or arXiv sources. Some older entries retain source-transcribed metadata. This is a curated bibliography, not a guarantee of an exhaustive publication list.','추가 자료는 출판사 또는 arXiv와 대조했습니다. 일부 과거 항목은 기존 사이트의 서지정보를 유지합니다. 현재 확보한 자료를 정리한 목록으로, 전체 논문의 완전성을 보장하지는 않습니다.')}</p></div>}
{section==='news'&&<div class="container content-bottom">{news.length?news.map((n:any)=><article class="news-item"><time datetime={n.date}>{n.date}</time><h2>{n.title[l]}</h2><p>{n.summary[l]}</p><a class="text-link" href={n.sourceUrl}>{t(l,'Read more','자세히 보기')} ↗</a></article>):<div class="empty-editorial"><span class="eyebrow">{t(l,'THE NEXT CHAPTER','새로운 기록')}</span><h2>{t(l,'Updates, when there is','나눌 소식이 생기면')}<br/><em>{t(l,'something to share.','이곳에서 전하겠습니다.')}</em></h2><p>{t(l,'No approved announcements have been added yet. Research highlights, seminars, and group news will appear here.','아직 게재가 확정된 소식이 없습니다. 연구 성과, 세미나와 연구실 소식을 이곳에 소개할 예정입니다.')}</p><a class="text-link" href={url(l,'publications')}>{t(l,'Explore the research archive','연구 기록 살펴보기')} ↗</a></div>}</div>}
{section==='join'&&<div class="container content-bottom"><div class="join-intro"><h2>{t(l,'Explore questions at the','양자정보의 경계에서')}<br/><em>{t(l,'edge of quantum information.','함께 질문해 보세요.')}</em></h2><p class="lead">{t(l,'If your interests connect with quantum computing, communication, sensing, or the foundations of quantum theory, you can contact the group to discuss research interests and possible opportunities.','양자컴퓨팅, 양자통신, 양자센싱, 양자 기초이론에 관심이 있다면 연구 관심사와 참여 가능성에 관해 문의하실 수 있습니다.')}</p></div><div class="join-options"><article><span class="eyebrow">01 / STUDENTS</span><h3>{t(l,'Prospective graduate students','대학원 진학 관심자')}</h3><p>{t(l,'Review the official POSTECH graduate admissions information for eligibility, application procedures, and current deadlines.','지원 자격, 절차와 최신 일정은 POSTECH 대학원 공식 입학 안내를 확인해 주세요.')}</p><a class="text-link" href={info.admissionsUrl}>{t(l,'POSTECH graduate admissions','POSTECH 대학원 입학 안내')} ↗</a></article><article><span class="eyebrow">02 / RESEARCHERS</span><h3>{t(l,'Research & collaboration','연구 참여·공동연구')}</h3><p>{t(l,'A short introduction and a description of your research interests are a helpful way to begin a conversation. Specific vacancies and funding have not been confirmed.','간단한 소개와 연구 관심사를 적어 문의해 주세요. 현재 채용 공고와 지원 재원은 확인되지 않았습니다.')}</p><a class="text-link" href={`mailto:${info.email}?subject=Research%20inquiry%20%E2%80%94%20QIT`}>{t(l,'Contact Seung-Woo Lee','이승우 교수에게 문의')} ↗</a></article></div><div class="editorial-note"><h3>{t(l,'Before you apply','지원 전 확인')}</h3><p>{t(l,'This page is an invitation to inquire, not an announcement of an open position. Please use official admissions channels for applications. Do not email identity documents or other sensitive personal records.','이 페이지는 문의를 위한 안내이며 확정된 모집 공고가 아닙니다. 입학 지원은 공식 채널을 이용하시고, 신분증 등 민감한 개인정보는 이메일로 보내지 마세요.')}</p></div></div>}
{section==='contact'&&<div class="container content-bottom"><div class="contact-grid"><div><h2>{t(l,'Quantum Information','Quantum Information')}<br/><em>Theory Group</em></h2><p class="lead">POSTECH · {info.department[l]}</p><dl><dt>{t(l,'Research contact','연구 문의')}</dt><dd><a href={`mailto:${info.email}`}>{info.email} ↗</a></dd><dt>{t(l,'Faculty office','교수 사무실')}</dt><dd>{info.office}<small>{t(l,'Room designation as listed by the department. Confirm building and visitor directions before travelling.','학과 공식 표기 기준입니다. 방문 전 건물명과 이동 경로를 문의해 주세요.')}</small></dd><dt>{t(l,'University postal address','대학 우편 주소')}</dt><dd>{info.address[l]}<small>{t(l,'Campus address; not a laboratory delivery instruction.','대학 주소이며 연구실 배송 위치를 뜻하지 않습니다.')}</small></dd></dl><a class="text-link" href={info.profileUrl}>{t(l,'Verify contact details at POSTECH','POSTECH 공식 연락처 확인')} ↗</a></div><div class="contact-art"><QuantumArt compact/><div><span class="eyebrow">POHANG, REPUBLIC OF KOREA</span><p>{t(l,'A place for fundamental questions.','근본적인 질문이 시작되는 곳.')}</p></div></div></div></div>}
</>}
<script>
const form=document.querySelector<HTMLFormElement>('#publication-filters');
if(form){
 const search=document.querySelector<HTMLInputElement>('#paper-search')!;
 const select=document.querySelector<HTMLSelectElement>('#paper-year')!;
 const type=document.querySelector<HTMLSelectElement>('#paper-type')!;
 const rows=[...document.querySelectorAll<HTMLElement>('[data-paper]')];
 const count=document.querySelector<HTMLElement>('#paper-count')!;
 const empty=document.querySelector<HTMLElement>('#no-results')!;
 const filter=()=>{const query=search.value.trim().toLocaleLowerCase();let n=0;for(const row of rows){const show=(select.value==='all'||row.dataset.year===select.value)&&(type.value==='all'||row.dataset.type===type.value)&&(row.dataset.search||'').includes(query);row.hidden=!show;if(show)n++;}count.textContent=`${n} ${document.documentElement.lang==='ko'?count.dataset.ko:count.dataset.en}`;empty.hidden=n!==0;};
 form.addEventListener('submit',e=>e.preventDefault());search.addEventListener('input',filter);select.addEventListener('change',filter);type.addEventListener('change',filter);form.addEventListener('reset',()=>{requestAnimationFrame(filter);});
}
</script>
