---
import '../styles/global.css';
import {info,labels,sections,url,asset,t,review,type Lang} from '../lib/site';
const {lang='en', section='home', title, description} = Astro.props;
const other:Lang=lang==='en'?'ko':'en';
const site=Astro.site;
const canonical=site && section!=='404' ? new URL(url(lang,section),site).href : undefined;
const defaultDescription=t(lang,'Quantum Information Theory Group in the Department of Physics at POSTECH. Research in quantum computing, communication, sensing, and the foundations of quantum theory.','POSTECH 물리학과 Quantum Information Theory Group. 양자컴퓨팅, 양자통신, 양자센싱과 양자 기초이론을 연구합니다.');
---
<!doctype html><html lang={lang}><head>
<meta charset="UTF-8"/><script is:inline>document.documentElement.classList.add("js");</script><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title ? `${title} — QIT · POSTECH` : 'Quantum Information Theory Group — POSTECH'}</title>
<meta name="description" content={description || defaultDescription}/>
<meta name="robots" content={review || section==='404'?'noindex, nofollow':'index, follow'}/><meta name="theme-color" content="#f7f4ef"/>
<link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}/>
{canonical && <><link rel="canonical" href={canonical}/>{(['en','ko'] as Lang[]).map(l=><link rel="alternate" hreflang={l} href={new URL(url(l,section),site).href}/>)}<link rel="alternate" hreflang="x-default" href={new URL(url('en',section),site).href}/></>}
<meta property="og:title" content={title ? `${title} — QIT · POSTECH` : 'Quantum Information Theory Group — POSTECH'}/><meta property="og:description" content={description||defaultDescription}/><meta property="og:type" content="website"/><meta property="og:locale" content={lang==='ko'?'ko_KR':'en_US'}/>{canonical&&<meta property="og:url" content={canonical}/>}
{!review && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ResearchOrganization',name:info.name,url:site?new URL(url(lang),site).href:undefined,parentOrganization:{'@type':'CollegeOrUniversity',name:'POSTECH'},email:info.email})}/>}
</head><body>
<a class="skip-link" href="#main">{t(lang,'Skip to content','본문 바로가기')}</a>
{review&&<div class="review-bar" role="region" aria-label={t(lang,'Review edition status','검토용 상태')}><span>{t(lang,'REVIEW EDITION','검토용 시안')}</span> {t(lang,'Prepared for faculty review · 13 October 2026','교수님 검토용 · 2026년 10월 13일')}<a href="#review-note">{t(lang,'Content status','정보 확인 상태')} ↓</a></div>}
<header class="site-header"><div class="container header-inner">
<a class="brand" href={url(lang)} aria-label={t(lang,'QIT POSTECH — Home','QIT POSTECH — 홈')}><span class="brand-mark">qit<span>↗</span></span><span class="brand-divider"></span><span class="brand-institution"><img class="postech-wordmark" src={asset('brand/postech-wordmark.png')} width="733" height="62" alt="POSTECH"/><small>{t(lang,'DEPARTMENT OF PHYSICS','물리학과')}</small></span></a>
<button id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="navigation">{t(lang,'Menu','메뉴')} <span aria-hidden="true">☰</span></button>
<nav id="navigation" aria-label={t(lang,'Main navigation','주 메뉴')}><ul>{sections.map((s,i)=><li><a class:list={{active:section===s}} aria-current={section===s?'page':undefined} href={url(lang,s)}>{labels[lang as Lang][i]}</a></li>)}</ul><a class="language" href={url(other,section==='404'?'home':section)} lang={other} hreflang={other}>{lang==='en'?'한국어':'EN'} <span aria-hidden="true">↗</span></a></nav>
</div></header>
<main id="main"><slot/></main>
{review&&<aside class="review-note container" id="review-note"><div><span class="eyebrow">{t(lang,'ABOUT THIS EDITION','이 시안의 정보 기준')}</span><h2>{t(lang,'A clear record. A considered next chapter.','검증된 정보와 확인할 정보를 구분합니다.')}</h2></div><div><p>{t(lang,'The faculty affiliation and professional contact are supported by the POSTECH Physics directory. Historical publications are identified as a KIST-era archive; they are not a complete record of the current group.','교수 소속·업무 연락처는 POSTECH 물리학과 공식 자료를 기준으로 합니다. 논문은 KIST 시절 보존 자료로 표시하며 현재 연구실의 전체 성과 목록을 뜻하지 않습니다.')}</p><p><strong>{t(lang,'Awaiting confirmation: ','확인 필요: ')}</strong>{info.pending[lang as Lang].join(' · ')}</p><a class="text-link" href={info.profileUrl}>{t(lang,'POSTECH faculty source','POSTECH 교수 정보 출처')} ↗</a></div></aside>}
<footer><div class="container footer-grid"><div><a class="footer-brand" href={url(lang)}>Quantum Information<br/>Theory Group<img class="footer-wordmark" src={asset('brand/postech-wordmark.png')} width="733" height="62" alt="POSTECH" loading="lazy"/></a></div><div><p>{t(lang,'Department of Physics','포항공과대학교 물리학과')}</p><p>{info.address[lang as Lang]}</p><a href={`mailto:${info.email}`}>{info.email} ↗</a></div><div class="footer-links"><a href={url(lang,'research')}>{t(lang,'Explore our research','연구 살펴보기')} ↗</a><a href={url(lang,'join')}>{t(lang,'Connect with us','연구실 참여')} ↗</a><a href={info.legacyUrl}>{t(lang,'KIST-era website','KIST 시절 사이트')} ↗</a></div></div><div class="container footer-bottom"><span>QIT · POSTECH</span><span>{t(lang,'Quantum information, shared openly.','함께 탐구하는 양자정보.')}</span><span>{t(lang,'Sources checked','출처 확인')} 2026.10.13</span></div></footer>
<script>
const button=document.querySelector<HTMLButtonElement>('#menu-toggle');
const nav=document.querySelector<HTMLElement>('#navigation');
button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open);});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){button.setAttribute('aria-expanded','false');nav?.classList.remove('open');button.focus();}});
</script>
</body></html>
